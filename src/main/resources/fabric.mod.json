{
  "schemaVersion": 1,
  "id": "modhub",
  "version": "${version}",
  "name": "Mod Hub",
  "icon": "assets/modhub/icon.png",
  "description": "A mod list and a settings home in one: find every installed mod, open its settings, and pin shortcuts to your favourites.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mod-hub",
    "sources": "https://github.com/trevorschoeny/mod-hub",
    "issues": "https://github.com/trevorschoeny/mod-hub/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.trevlar.modhub.ModHub"
    ],
    "client": [
      "com.trevlar.modhub.ModHubClient"
    ],
    "modhub": [
      "com.trevlar.modhub.ModHubSettings"
    ],
    "modhub:adapter": [
      "com.trevlar.modhub.compat.yacl.YaclAdapter",
      "com.trevlar.modhub.compat.cloth.ClothConfigAdapter",
      "com.trevlar.modhub.compat.midnightlib.MidnightLibAdapter",
      "com.trevlar.modhub.compat.fcap.ForgeConfigApiPortAdapter"
    ]
  },
  "mixins": [
    "modhub.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/modhub-modmenu-api.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.1.0 <8.0.0"
  },
  "breaks": {
    "keybindery": "<1.2.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
